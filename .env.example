# Epistecnica local configuration template. Copy to .env and fill in real
# values (.env is git-ignored). Loaded by make (deploys) and by bin/envutil.py;
# real environment variables still win.
EPISTECNICA_PORT=8000

# One CouchDB instance hosts both databases.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASSWORD=

# Database names (one per dataset, plus the notes-catalog pins store).
EPISTEMICA_DB=epistemica
TECNICA_DB=tecnica
NOTES_DB=notes
