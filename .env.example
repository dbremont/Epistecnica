# Epistecnica combined server (.env — gitignored; copy to .env and fill in).
# Read by bin/envutil.py; real environment variables override these values.

# One CouchDB instance hosts both databases.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASSWORD=

# Database names (one per dataset).
EPISTEMICA_DB=epistemica
TECNICA_DB=tecnica

# Server port (deploy.sh uses EPISTECNICA_PORT instead when set).
PORT=8000
