{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturgnosis.org/schemas/gov-wide-administration-comparative-system-representation.schema.json",
  "title": "Government-Wide Administration Space",
  "description": "A comparative representation systems catalogue: a shared meta block and the systems, each a set of characteristic elements with their value sets and assignment rules.",
  "type": "object",
  "required": [
    "meta",
    "systems"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "space": {
          "type": "object"
        },
        "universe": {
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer",
            "number"
          ]
        }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "system": {
      "type": "object",
      "required": [
        "name",
        "title",
        "version",
        "characteristic_element_set"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "frame_basis": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "universe": {
          "type": [
            "string",
            "object"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer",
            "number"
          ]
        },
        "related_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "characteristic_element_set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "additionalProperties": true
    },
    "element": {
      "type": "object",
      "required": [
        "name",
        "value_set"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "assignment_rule": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "nominal",
            "ordinal"
          ]
        },
        "value_set": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
