            "= −log₁₀({h} × 10^{e}).",
            "= {ans}."
          ]
        },
        {
          "id": "ph-dilution",
          "kind": "ph-dilute",
          "prompt": "A solution at pH <b>{ph}</b> is diluted <b>{k}×</b> more. What is the new pH?",
          "tolerance": {
            "kind": "abs",
            "value": 0.05
          },
          "unit": "",
          "steps": [
