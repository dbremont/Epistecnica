            "log₁₀({k}) = {delta}.",
            "New pH = {ph} + {delta} = {ans}."
          ]
        },
        {
          "id": "scale-decibels",
          "kind": "decibels",
          "prompt": "Sound intensity rises <b>×{F}</b>. How many <b>dB</b> louder is that?",
          "tolerance": {
            "kind": "rel",
            "pct": 2
          },
          "unit": "dB",
          "steps": [
            "dB = 10 log₁₀(intensity ratio).",
            "= 10 × log₁₀({F}).",
            "= {ans} dB."
          ]
        }
      ]
    },
    {
      "id": "half-life",
      "name": "Half-Life",
      "icon": "☢️",
      "color": "#94a3b8",
      "blurb": "Decay is exponential: what fraction survives, and when.",
      "schemes": [
        {
          "id": "hl-remaining",
          "kind": "half-life",
          "prompt": "After <b>{n}</b> half-lives, what <b>fraction</b> of the original remains?",
          "tolerance": {
            "kind": "rel",
            "pct": 1
          },
          "unit": "",
          "steps": [
            "Fraction = (1/2)^{n}.",
            "= {ans}.",
            "That is {pct}% of the original."
          ]
        },
        {
          "id": "hl-count",
          "kind": "half-life-count",
          "prompt": "A sample decays for <b>{t} years</b>; its half-life is <b>{hl} years</b>. How many <b>half-lives</b> is that?",
          "tolerance": {
            "kind": "rel",
            "pct": 1
          },
          "unit": "half-lives",
          "steps": [
            "n = t / half-life.",
            "= {t} / {hl}.",
            "= {ans}."
          ]
        },
        {
          "id": "hl-time",
          "kind": "half-life-time",
          "prompt": "Half-life <b>{hl} years</b> — how long until only <b>1/{denom}</b> remains?",
          "tolerance": {
            "kind": "rel",
            "pct": 1
          },
          "unit": "years",
          "steps": [
            "1/{denom} needs log₂({denom}) = {k} half-lives.",
            "Time = {k} × {hl}.",
            "= {ans} years."
          ]
        }
      ]
    }
  ]
}
