      "id": "normal",
      "name": "Standard Normal",
      "symbol": "Z",
      "family": "continuous",
      "support": "(-∞, ∞)",
      "parameters": "μ ∈ ℝ, σ > 0",
      "statistic": "z = (x̄ − μ₀) / (σ/√n)",
      "definition": "The exact null law of the z-statistic when σ is known, and the large-sample limit of any standardized statistic whose null has finite variance.",
      "engine": "normal",
      "analytic": true,
      "params": [
        { "name": "mu", "label": "μ", "default": 0, "min": -5, "max": 5, "step": 0.1 },
