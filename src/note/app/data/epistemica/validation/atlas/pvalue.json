      ],
      "formulas": {
        "density": "\\varphi(t;\\mu,\\sigma)=\\frac{1}{\\sigma\\sqrt{2\\pi}}\\,e^{-\\frac{(t-\\mu)^2}{2\\sigma^2}}",
        "cdf": "F(t)=\\Phi\\!\\left(\\frac{t-\\mu}{\\sigma}\\right)",
        "p_left": "p_{\\mathrm{left}}=\\Phi\\!\\left(\\frac{t_{\\mathrm{obs}}-\\mu}{\\sigma}\\right)",
        "p_right": "p_{\\mathrm{right}}=1-\\Phi\\!\\left(\\frac{t_{\\mathrm{obs}}-\\mu}{\\sigma}\\right)",
        "p_two": "p_{\\mathrm{two}}=2\\left[1-\\Phi\\!\\left(\\frac{|t_{\\mathrm{obs}}-\\mu|}{\\sigma}\\right)\\right]"
      },
      "p_convention": "Symmetric null: the two-sided p doubles the smaller tail and is capped at 1. Under H₀ with a continuous statistic the p-value is Uniform(0,1).",
      "tests": ["z-test for a mean with known σ", "Wald test", "score test (asymptotic)", "sign test (asymptotic)"],
      "related": ["student-t", "cauchy"],
      "notes": ["epistemica/validation/p-value.md", "epistemica/validation/statistical-hypothesis-testing.md", "epistemica/observational/gaussian-distribution.md"],
      "sources": [
        { "label": "Wikipedia: Normal distribution", "url": "https://en.wikipedia.org/wiki/Normal_distribution" },
