        "cdf": "F(t)=1-\\tfrac{1}{2}\\,I_{\\frac{\\nu}{\\nu+t^2}}\\!\\left(\\frac{\\nu}{2},\\frac{1}{2}\\right),\\quad t\\ge 0",
        "p_left": "p_{\\mathrm{left}}=F(t_{\\mathrm{obs}})",
        "p_right": "p_{\\mathrm{right}}=1-F(t_{\\mathrm{obs}})",
